# EasyChat 部署配置（复制为 .env）
# 单容器：SQLite + 进程内调度器/worker，不需要 MySQL/Redis/Neo4j/Milvus。

PORT=8001

# 必填：>=32 位随机串；不填 compose 会拒绝启动
EASYCHAT_JWT_SECRET=please-change-to-a-random-64-char-secret

# 渠道凭证 / SMTP 密码加密密钥（启用微信或邮件时必填）
EASYCHAT_ENCRYPTION_SECRET=

# 能力开关（默认关闭）
EASYCHAT_HERMES_ENABLED=false
EASYCHAT_WECHAT_ENABLED=false
EASYCHAT_MCP_ENABLED=false
EASYCHAT_EMAIL_ENABLED=false
EASYCHAT_PDF_ENABLED=false
EASYCHAT_RUNNER_ENABLED=false

# Hermes/模型凭证不要写进镜像；启用 Hermes 后由运行时模型配置/环境提供
# LLM_API_KEY=
# LLM_BASE_URL=
