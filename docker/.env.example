# ═══════════════════════════════════════════════════════════
# AgentForge Docker 配置
# ═══════════════════════════════════════════════════════════

# ── Docker 服务密码 ──
MYSQL_ROOT_PASSWORD=agentforge123
NEO4J_PASSWORD=agentforge123

# ═══════════════════════════════════════════════════════════
# AgentForge 应用配置
# ═══════════════════════════════════════════════════════════

# ── MySQL（Docker）──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=agentforge123
MYSQL_DATABASE=agentforge

# ── Neo4j（Docker，可选，GraphRAG）──
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=agentforge123

# ── Redis（Docker，缓存层）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Milvus（Docker，可选，向量库）──
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── 服务配置 ──
PORT=8001
ALLOWED_ORIGINS=*
# ⚠️ 必填：请生成一个随机密钥再启动，否则服务会拒绝启动（这是有意的 fail-fast）。
#    生成命令： python -c "import secrets;print(secrets.token_hex(32))"
#    不要沿用本文件的占位值 —— 它是公开的，用它能伪造任意用户（含 super_admin）的 Token。
#    仅本机调试时若确实想跳过强度校验，可显式设置 ALLOW_WEAK_JWT_SECRET=1
JWT_SECRET=REPLACE_ME_WITH_RANDOM_64_HEX

# ── 日志配置 ──
LOG_LEVEL=INFO