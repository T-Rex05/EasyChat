# ============================================================
# .dockerignore — 排除不需要进入 Docker 镜像的文件
# ============================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.whl

# ── 虚拟环境 ──
venv/
.venv/
env/

# ── 环境变量（含密钥，绝不入镜像） ──
.env
.env.local
.env.*.local

# ── 日志和运行时数据 ──
data/
*.log

# ── Hermes 运行时 ──
backend/hermes/.home/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── 操作系统 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Node（node_modules 不进上下文；源码/锁文件必须进前端构建阶段） ──
node_modules/
agent_frontend/node_modules/
agent_frontend/dist/
agent_frontend/.vite/

# ── Git ──
.git/
.gitignore

# ── 开发文档（不进生产镜像） ──
CLAUDE.md
QUICKSTART.md
README.md
Makefile
*.md
!agent_frontend/README.md
!docs/architecture/operations.md

# ── 示例代码 ──
examples/

# ── 测试 ──
tests/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 工具生成 ──
.spec-workflow/
.superpowers/
.claude/

# ── Docker ──
docker-compose.override.yml

# ── 脚本（运维脚本不进镜像） ──
scripts/

# ── 报告（运行时产物） ──
reports/
static/charts/

# ── 临时文件 ──
111/
*.pdf
*.png
*.jpg
*.jpeg
*.gif
