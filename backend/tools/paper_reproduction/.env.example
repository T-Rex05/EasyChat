# 论文复现系统环境配置示例

# Docker 沙箱默认镜像
# 可选值：
# - python:3.10-slim          （默认，轻量级 Python）
# - pytorch/pytorch:latest    （深度学习，PyTorch）
# - tensorflow/tensorflow:latest-gpu （深度学习，TensorFlow + GPU）
# - astropy/astropy:latest    （天文学）
# - jupyter/scipy-notebook    （科学计算）

SANDBOX_DEFAULT_IMAGE=python:3.10-slim

# 如果需要 PyTorch（推荐预拉取镜像）：
# SANDBOX_DEFAULT_IMAGE=pytorch/pytorch:2.0.1-cuda11.7-cudnn8-runtime

# 如果需要 TensorFlow：
# SANDBOX_DEFAULT_IMAGE=tensorflow/tensorflow:latest-gpu

# 如果是天文学论文：
# SANDBOX_DEFAULT_IMAGE=astropy/astropy:latest